# Database
# Локальная разработка:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_autoshop?schema=public"
# Production:
# DATABASE_URL="postgresql://crm_user:your-strong-password@localhost:5432/crm_autoshop?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth (for future authentication)
NEXTAUTH_SECRET="your-secret-key-here"
# Локальная разработка:
NEXTAUTH_URL="http://localhost:3000"
# Production:
# NEXTAUTH_URL="https://vyborsto.ru"

# App
NODE_ENV="development"
# Production:
# NODE_ENV="production"

# API URL
# Локальная разработка:
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
# Production:
# NEXT_PUBLIC_API_URL="https://api.vyborsto.ru"

# Domains
# DOMAIN="vyborsto.ru"
# API_DOMAIN="api.vyborsto.ru"
